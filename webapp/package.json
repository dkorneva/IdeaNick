{
  "name": "@IdeaNick/webapp",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "..\\node_modules\\.bin\\eslint.cmd --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts,.tsx .",
    "stylelint": "stylelint --cache --cache-location ./node_modules/.cache/.stylelintcache \"src/**/*.scss\"",
    "stylecheck": "sass --update -q ./src:./node_modules/.cache/.stylecheckcache",
    "preview": "vite preview",
    "types": "tsc --noEmit --project ./tsconfig.app.json && tsc --noEmit --project ./tsconfig.node.json",
    "prettify": "prettier --log-level warn --cache --write \"{src/**/*,*}.{ts,tsx,js,json,yml,scss}\" --ignore-pattern \"**/{node_modules,dist}/**/*\""
  },
  "dependencies": {
    "@IdeaNick/backend": "workspace:*",
    "@IdeaNick/shared": "workspace:*",
    "@nanostores/react": "^1.1.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.45.2",
    "@trpc/react-query": "^10.45.2",
    "@trpc/server": "^10.45.4",
    "classnames": "^2.5.1",
    "date-fns": "^4.4.0",
    "formik": "^2.4.9",
    "formik-validator-zod": "^1.0.2",
    "include-media": "^2.0.0",
    "js-cookie": "^3.0.8",
    "lodash": "^4.18.1",
    "nanostores": "^1.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.7.0",
    "react-infinite-scroller": "^1.2.6",
    "react-router-dom": "^7.18.2",
    "reset-css": "^5.0.2",
    "sass": "^1.102.0",
    "superjson": "^2.2.6",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-infinite-scroller": "^1.2.5",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.7.0",
    "prettier": "^3.0.1",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.1.1",
    "vite-plugin-svgr": "^5.2.0"
  }
}
