generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  nick      String   @unique
  name String @default("")
  password  String
  createdAt DateTime @default(now())
  Ideas     Idea[]
}

model Idea {
  id          String   @id @default(uuid())
  nick        String   @unique
  serialNumber Int @unique @default(autoincrement())
  name        String
  description String
  text        String
  createdAt   DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}
