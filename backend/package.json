{
  "name": "@IdeaNick/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm build-emails && ts-node-dev --watch ./src/emails/dist,./.env --rs --exit-child ./src/index.ts",
    "test": "jest",
    "build-emails": "rimraf ./src/emails/dist && node -e \"require('fs').mkdirSync('./src/emails/dist',{recursive:true})\" && mjml --config.allowIncludes true \"./src/emails/[!_]*.mjml\" -o ./src/emails/dist",
    "watch-emails": "node -e \"require('fs').mkdirSync('./src/emails/dist',{recursive:true})\" && mjml --config.allowIncludes true -w \"./src/emails/[!_]*.mjml\" -o ./src/emails/dist",
    "copy-emails": "copyfiles ./src/emails/dist/*.html ./dist/backend",
    "build-ts": "rimraf ./dist && tsc --build ./tsconfig.json",
    "build": "pnpm build-ts && pnpm build-emails && pnpm copy-emails",
    "sentry-release": "dotenv -- node -e \"const {spawnSync}=require('child_process'); const version=process.env.SOURCE_VERSION; const token=process.env.SENTRY_AUTH_TOKEN; if(!version){console.error('SOURCE_VERSION is required'); process.exit(1)} if(!token){console.error('SENTRY_AUTH_TOKEN is required'); process.exit(1)} const result=spawnSync('sentry-cli',['releases','new',version,'--finalize','--org','ideanick-pf','--project','backend','--auth-token',token],{stdio:'inherit',shell:true}); process.exit(result.status ?? 1)\"",
    "sentry-sourcemaps": "dotenv -- node -e \"const {spawnSync}=require('child_process'); const version=process.env.SOURCE_VERSION; const token=process.env.SENTRY_AUTH_TOKEN; if(!version){console.error('SOURCE_VERSION is required'); process.exit(1)} if(!token){console.error('SENTRY_AUTH_TOKEN is required'); process.exit(1)} const result=spawnSync('sentry-cli',['sourcemaps','upload','./dist','--release',version,'--org','ideanick-pf','--project','backend','--auth-token',token],{stdio:'inherit',shell:true}); process.exit(result.status ?? 1)\"",
    "sentry-inject": "dotenv -- node -e \"const {spawnSync}=require('child_process'); const result=spawnSync('sentry-cli',['sourcemaps','inject','./dist'],{stdio:'inherit',shell:true}); process.exit(result.status ?? 1)\"",
    "sentry": "pnpm sentry-release && pnpm sentry-inject && pnpm sentry-sourcemaps",
    "start": "node ./dist/backend/src/index.js",
    "lint": "..\\node_modules\\.bin\\eslint.cmd --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts .",
    "pmd": "prisma migrate dev",
    "pgc": "prisma generate",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "prettify": "prettier --log-level warn --cache --write \"{src/**/*,*}.{ts,tsx,js,json,yml,scss}\" --ignore-pattern \"**/{node_modules,dist}/**/*\"",
    "prepare": "pnpm pgc && ts-patch install -s"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@IdeaNick/shared": "workspace:*",
    "@IdeaNick/webapp": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/integrations": "^7.114.0",
    "@sentry/node": "^10.70.0",
    "@trpc/server": "^10.45.2",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mjml": "^5.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "picocolors": "^1.1.1",
    "react-router-dom": "^7.18.2",
    "serialize-error": "8.1.0",
    "superjson": "^2.2.6",
    "triple-beam": "^1.4.1",
    "trpc-playground": "^1.0.4",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@sentry/cli": "^3.6.2",
    "@types/cors": "^2.8.19",
    "@types/cron": "^2.4.3",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.2",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.4",
    "@types/triple-beam": "^1.3.5",
    "dotenv-cli": "^11.0.0",
    "eslint-plugin-node": "^11.1.0",
    "prisma": "^7.9.1"
  }
}
