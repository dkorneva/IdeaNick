{
  "name": "IdeaNick",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "b": "pnpm --filter @IdeaNick/backend",
    "w": "pnpm --filter @IdeaNick/webapp",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "types": "pnpm b types && pnpm w types",
    "lint": "pnpm b lint && pnpm w lint",
    "prettify": "pnpm -r --parallel prettify",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.4",
    "copyfiles": "^2.4.1",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.2.0",
    "prettier": "^3.4.2",
    "prettier-eslint": "^16.3.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "ts-patch": "^3.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.24.0",
    "typescript-transform-paths": "^4.0.0"
  },
  "overrides": {
    "eslint": "9.20.0"
  }
}
